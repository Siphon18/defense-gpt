# ─── LLM Provider ───
# Set LLM_PROVIDER to "groq" or "gemini"
LLM_PROVIDER=groq

# ─── Groq ───
# Get your free API key at: https://console.groq.com/keys
# Powers both text and multimodal/vision capabilities
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─── Gemini (optional secondary fallback) ───
# Optional fallback for multimodal prompts. Not required when GROQ_API_KEY is configured.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── MongoDB Atlas ───
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/defensegpt?retryWrites=true&w=majority

# ─── Web Search ───
# No API keys needed — Scrapling uses DuckDuckGo Lite scraping by default.
# The old FIRECRAWL_API_KEY / GOOGLE_SEARCH_API_KEY / GOOGLE_SEARCH_CX
# variables are no longer required and can be removed from your .env.
